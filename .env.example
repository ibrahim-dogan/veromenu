# --- VeroMenu local env (never commit) ---
DATABASE_URL=postgres://veromenu:veromenu@localhost:5433/veromenu
APP_URL=http://localhost:3000
# 32-byte hex, used for session signing + encrypting stored API keys
APP_SECRET=change-me-openssl-rand-hex-32
# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
# First platform admin (created by `pnpm db:seed`)
ADMIN_EMAIL=admin@veromenu.local
ADMIN_PASSWORD=ChangeMe123!
# SMTP (optional – if empty, mails are printed to the server log)
SMTP_URL=
MAIL_FROM="VeroMenu <no-reply@veromenu.de>"
# Default LLM provider (seeded into DB; can be changed in Admin → AI)
OPENROUTER_API_KEY=

# --- Production (docker-compose.yml) ---
POSTGRES_PASSWORD=change-me
DOMAIN=
APP_PORT=3000

# --- Operator data for Impressum / Datenschutz (DDG §5) ---
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_VAT_ID=
LEGAL_REPRESENTATIVE=
LEGAL_REGISTER=
LEGAL_SUPERVISORY_AUTHORITY=
LEGAL_HOSTER=
