{
  "name": "vero-menu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env --conditions=react-server scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env --conditions=react-server scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "themes:sync": "tsx scripts/sync-themes.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "db:seed:demo": "tsx --env-file=.env --conditions=react-server scripts/seed.ts --demo",
    "ai:smoke": "tsx --env-file=.env --conditions=react-server scripts/ai-smoke.ts",
    "build:scripts": "node scripts/build-scripts.mjs",
    "docker:build": "docker build -t veromenu:latest .",
    "start:prod": "node .next/standalone/server.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.2.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.54.0",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.0.16",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@node-rs/argon2"
    ]
  }
}
