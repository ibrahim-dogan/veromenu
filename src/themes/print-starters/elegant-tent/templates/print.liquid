<article class="tent{% if table.is_generic %} tent--generic{% endif %}" data-face="{{ card.face }}">
  <div class="frame">
    <div class="qr-col">
      <div class="qr">{{ table.qr_svg }}</div>
    </div>
    <div class="text-col">
      {%- if settings.show_logo and restaurant.logo_url -%}<img class="logo" src="{{ restaurant.logo_url }}" alt="">{%- endif -%}
    {%- if settings.show_name -%}<p class="name">{{ restaurant.name }}</p>{%- endif -%}
      <span class="rule" aria-hidden="true"></span>
      {%- if settings.show_table and table.is_generic == false -%}
      <p class="table">
      {%- if table.number != table.label -%}<span class="table-word">{{ 'tableWord' | t }}</span>{%- endif -%}
      <span class="table-number">{{ table.number }}</span>
      {%- if table.area -%}<span class="table-area">{{ table.area }}</span>{%- endif -%}
    </p>
      {%- elsif settings.show_headline and settings.headline != blank -%}
      <p class="headline">{{ settings.headline }}</p>
      {%- endif -%}
      {% render 'scan' %}
      {%- if settings.show_ordering and ordering.enabled -%}{%- unless table.is_generic -%}<p class="order">{{ 'orderAtTable' | t }}</p>{%- endunless -%}{%- endif -%}
      {% render 'wifi' %}
      {% render 'footer' %}
    </div>
  </div>
</article>
