<a class="skip" href="#menu">{{ 'skipToMenu' | t }}</a>
{%- if settings.gingham -%}<div class="gingham" aria-hidden="true"></div>{%- endif -%}
<header class="masthead">
  {%- if table -%}<p class="table">{{ 'table' | t: label: table.label }}</p>{%- endif -%}
  {%- if restaurant.logo_url -%}<img class="logo" src="{{ restaurant.logo_url }}" alt="" width="96" height="96">{%- endif -%}
  {%- if settings.welcome != blank -%}<p class="welcome">{{ settings.welcome }}</p>{%- endif -%}
  <h1>{{ restaurant.name }}</h1>
  {%- if restaurant.cuisine -%}<p class="cuisine">{{ restaurant.cuisine }}</p>{%- endif -%}
  <div class="ornament" aria-hidden="true"><span></span>❦<span></span></div>
</header>

{% render 'nav' %}

<main id="menu">
  {%- for menu in menus -%}
  <section class="menu{% unless menu.active_now %} is-closed{% endunless %}" aria-labelledby="m-{{ menu.id }}">
    {%- if menus.size > 1 -%}
    <h2 class="menu-title" id="m-{{ menu.id }}">{{ menu.name }}</h2>
    {%- if menu.description -%}<p class="menu-desc">{{ menu.description }}</p>{%- endif -%}
    {%- else -%}
    <h2 class="sr-only" id="m-{{ menu.id }}">{{ menu.name }}</h2>
    {%- endif -%}
    {%- unless menu.active_now -%}<p class="notice">{{ 'notAvailableNow' | t }}</p>{%- endunless -%}
    {%- for category in menu.categories -%}
    <section class="category" id="c-{{ category.id }}" data-category="{{ category.id }}" aria-labelledby="h-{{ category.id }}">
      <header class="category-head">
        <h3 id="h-{{ category.id }}">{{ category.name }}</h3>
        {%- if category.description -%}<p>{{ category.description }}</p>{%- endif -%}
      </header>
      <ul class="dishes" role="list">
        {%- for item in category.items -%}{% render 'item', item: item %}{%- endfor -%}
      </ul>
    </section>
    {%- endfor -%}
  </section>
  {%- endfor -%}
  <p class="buon" aria-hidden="true">{{ 'buonAppetito' | t }}</p>
</main>

{% render 'footer' %}
{%- if settings.gingham -%}<div class="gingham gingham-bottom" aria-hidden="true"></div>{%- endif -%}
